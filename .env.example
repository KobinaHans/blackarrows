# ─── Public (exposed to the browser; safe to commit values) ───────────────────
# Canonical site URL (no trailing slash). Used for metadata, sitemap, JSON-LD.
NEXT_PUBLIC_SITE_URL=https://tekkoengineering.com
NEXT_PUBLIC_CONTACT_EMAIL=info@tekkoengineering.com
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_ADDRESS_STREET=
NEXT_PUBLIC_ADDRESS_CITY=Accra
NEXT_PUBLIC_ADDRESS_REGION=Greater Accra
NEXT_PUBLIC_LINKEDIN_URL=

# ─── Server-only (NEVER prefix with NEXT_PUBLIC_, never commit real values) ───
# Resend API key – https://resend.com/api-keys. When unset in development the
# contact form logs the enquiry to the server console instead of sending.
RESEND_API_KEY=
# Inbox that receives lead notifications.
CONTACT_TO_EMAIL=info@tekkoengineering.com
# Verified sender on your Resend domain.
CONTACT_FROM_EMAIL="TEKKO Website <noreply@tekkoengineering.com>"
# Contact form rate limit: max submissions per IP within the window.
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_SECONDS=600
